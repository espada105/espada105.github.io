---
import '../styles/global.css';
import '../styles/pixel.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; homeShell?: boolean; }
const { title = 'hongseongin — AI Engineer', description = 'AI Engineer 홍성인의 소개와 프로젝트를 담은 포트폴리오.', homeShell = false } = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta name="theme-color" content="#f4efdf" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head><body class:list={{ 'home-shell': homeShell }}><a class="skip-link" href="#main">본문으로 바로가기</a>{!homeShell && <header class="site-header"><a class="wordmark" href="/" aria-label="hongseongin 홈"><span class="pixel-mark" aria-hidden="true"></span>{profile.handle}</a><nav aria-label="메인 메뉴"><a href="/#about">About</a><a href="/#projects">Projects <span class="nav-dot"></span></a><a class="github-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a></nav></header>}<slot />{!homeShell && <footer><a class="wordmark" href="/"><span class="pixel-mark" aria-hidden="true"></span>{profile.handle}</a><span>홍성인 / AI Engineer</span><a href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>}</body></html>
