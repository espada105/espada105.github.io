  { id: 'python', label: 'PYTHON', description: 'AI Engineering Tech Stack', detail: 'AI Engineering Tech Stack 학습 저장소에 명시된 Python 기반 학습 및 구현 환경입니다.', href: 'https://github.com/espada105/AI_Engineering_Tech_Stack', x: 1105, y: 345, type: 'leaf', parent: 'skills' },
