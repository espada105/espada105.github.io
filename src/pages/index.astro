  { id: 'mcp-api', label: 'MCP + API', description: 'FastMCP · FastAPI', detail: 'FastMCP와 FastAPI를 이용한 에이전트·서비스 연결 기술입니다.', href: 'https://github.com/espada105/AI_Engineering_Tech_Stack', x: 1190, y: 555, type: 'leaf', parent: 'skills' },

