<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const liveNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const liveLines = [...document.querySelectorAll<SVGLineElement>('.map-lines line')];
  const basePositions = liveNodes.map((node) => ({
    node,
    x: Number.parseFloat(node.style.getPropertyValue('--x')),
    y: Number.parseFloat(node.style.getPropertyValue('--y')),
    phase: Number(node.dataset.index || 0) * 0.73,
  }));

  if (!reduceMotion.matches) {
    const animateGraph = (time: number) => {
      const positions = basePositions.map(({ node, x, y, phase }) => {
        const amplitude = node.classList.contains('leaf') ? 6 : node.classList.contains('branch') ? 4 : 2;
        const offsetX = Math.sin(time / 2900 + phase) * amplitude;
        const offsetY = Math.cos(time / 3500 + phase * 1.3) * amplitude;
        node.style.translate = `${offsetX}px ${offsetY}px`;
        return { x: x + offsetX, y: y + offsetY };
      });

      liveLines.forEach((line) => {
        const from = positions[Number(line.dataset.from)];
        const to = positions[Number(line.dataset.to)];
        line.setAttribute('x1', `${from.x}`);
        line.setAttribute('y1', `${from.y}`);
        line.setAttribute('x2', `${to.x}`);
        line.setAttribute('y2', `${to.y}`);
      });
      requestAnimationFrame(animateGraph);
    };
    requestAnimationFrame(animateGraph);
  }
</script>
<script>
  const graphSurface = document.querySelector<HTMLElement>('.map-viewport');
  const graphSurfaceWorld = document.querySelector<HTMLElement>('.map-world');
  const graphSurfaceNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  let graphDrag: { pointerId: number; x: number; y: number; worldX: number; worldY: number; scale: number } | undefined;

  const readWorldTransform = () => {
    if (!graphSurfaceWorld) return { x: 0, y: 0, scale: 1 };
    const transform = getComputedStyle(graphSurfaceWorld).transform;
    if (transform === 'none') return { x: 0, y: 0, scale: 1 };
    const matrix = new DOMMatrixReadOnly(transform);
    return { x: matrix.e, y: matrix.f, scale: matrix.a };
  };
  const writeWorldTransform = (x: number, y: number, scale: number) => {
    if (graphSurfaceWorld) graphSurfaceWorld.style.transform = `translate3d(${x}px,${y}px,0) scale(${scale})`;
  };
  const centerGraphNode = (id?: string) => {
    const node = graphSurfaceNodes.find((candidate) => candidate.dataset.node === id);
    if (!node || !graphSurface || !graphSurfaceWorld) return;
    requestAnimationFrame(() => {
      const viewport = graphSurface.getBoundingClientRect();
      const nodeX = Number.parseFloat(node.style.getPropertyValue('--x'));
      const nodeY = Number.parseFloat(node.style.getPropertyValue('--y'));
      const scale = Math.max(.48, Math.min(.82, viewport.width / 1040));
      const target = `translate3d(${viewport.width / 2 - nodeX * scale}px,${viewport.height / 2 - nodeY * scale}px,0) scale(${scale})`;
      const current = getComputedStyle(graphSurfaceWorld).transform;
      graphSurfaceWorld.getAnimations().forEach((animation) => animation.cancel());
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        graphSurfaceWorld.style.transform = target;
        return;
      }
      const animation = graphSurfaceWorld.animate([{ transform: current }, { transform: target }], {
        duration: 620,
        easing: 'cubic-bezier(.16,1,.3,1)',
        fill: 'forwards',
      });
      animation.finished.then(() => { graphSurfaceWorld.style.transform = target; animation.cancel(); });
    });
  };

  window.addEventListener('portfolio:center-node', (event) => centerGraphNode((event as CustomEvent<string>).detail));
  if (graphSurfaceWorld?.dataset.active) centerGraphNode(graphSurfaceWorld.dataset.active);

  // This capture-phase controller owns drag and zoom after a camera move. It
  // reads the rendered transform, so closing a detail card can never restore a
  // stale pre-focus graph position or leave dragging disabled.
  graphSurface?.addEventListener('pointerdown', (event) => {
    if ((event.target as HTMLElement).closest('.map-node, .node-tooltip, .detail-panel')) return;
    const state = readWorldTransform();
    graphDrag = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, worldX: state.x, worldY: state.y, scale: state.scale };
    graphSurface.setPointerCapture(event.pointerId);
    graphSurface.classList.add('dragging');
    event.preventDefault();
    event.stopImmediatePropagation();
  }, true);
  graphSurface?.addEventListener('pointermove', (event) => {
    if (!graphDrag || event.pointerId !== graphDrag.pointerId) return;
    writeWorldTransform(graphDrag.worldX + event.clientX - graphDrag.x, graphDrag.worldY + event.clientY - graphDrag.y, graphDrag.scale);
    event.preventDefault();
    event.stopImmediatePropagation();
  }, true);
  const releaseGraphDrag = (event: PointerEvent) => {
    if (!graphDrag || event.pointerId !== graphDrag.pointerId || !graphSurface) return;
    if (graphSurface.hasPointerCapture(event.pointerId)) graphSurface.releasePointerCapture(event.pointerId);
    graphDrag = undefined;
    graphSurface.classList.remove('dragging');
    event.stopImmediatePropagation();
  };
  graphSurface?.addEventListener('pointerup', releaseGraphDrag, true);
  graphSurface?.addEventListener('pointercancel', releaseGraphDrag, true);
  graphSurface?.addEventListener('wheel', (event) => {
    if (!graphSurface) return;
    const state = readWorldTransform();
    const viewport = graphSurface.getBoundingClientRect();
    const scale = Math.max(.35, Math.min(1.05, state.scale - event.deltaY * .00055));
    const x = (event.clientX - viewport.left - state.x) / state.scale;
    const y = (event.clientY - viewport.top - state.y) / state.scale;
    writeWorldTransform(event.clientX - viewport.left - x * scale, event.clientY - viewport.top - y * scale, scale);
    event.preventDefault();
    event.stopImmediatePropagation();
  }, { capture: true, passive: false });
  document.querySelector<HTMLButtonElement>('.detail-close')?.addEventListener('click', () => {
    graphDrag = undefined;
    graphSurface?.classList.remove('dragging');
    requestAnimationFrame(() => graphSurface?.focus());
  });
</script>
