  { id: 'space-security-paper', label: 'SPACE SECURITY AI', description: 'KASS · policy research', detail: '우주 안보 산업에서 AI 기술의 적용 동향과 정책을 다루는 연구입니다.', x: 1240, y: 800, type: 'leaf', parent: 'research' },

  { id: 'telepix', label: 'TELEPIX', description: 'AI Software Engineer', detail: 'LinkedIn에 공개된 TelePIX Co., Ltd. 경험입니다.', href: 'https://www.linkedin.com/in/seongin-hong-2b95b7345/', x: 510, y: 980, type: 'leaf', parent: 'experience' },
  { id: 'lg-aimers', label: 'LG AIMERS', description: '5th · 6th · 7th', detail: 'LG AI Research의 LG Aimers 5·6·7기 수료 이력입니다.', href: 'https://github.com/espada105/AI_Predicting_Pregnancy_Success', x: 700, y: 1005, type: 'leaf', parent: 'experience' },
  { id: 'hsu-lab', label: 'HSU AEROSPACE AI LAB', description: 'undergraduate research', detail: '한서대학교 대규모 항공우주 지능시스템 연구실 학부연구생 활동입니다.', href: 'https://www.linkedin.com/in/seongin-hong-2b95b7345/', x: 480, y: 775, type: 'leaf', parent: 'experience' },

  { id: 'github', label: 'GITHUB', description: 'espada105', detail: '공개 코드와 프로젝트 기록입니다.', href: profile.github, x: 400, y: 290, type: 'leaf', parent: 'contact' },
  { id: 'linkedin', label: 'LINKEDIN', description: 'Seongin Hong', detail: '공개된 경력, 연구, 프로젝트 이력입니다.', href: 'https://www.linkedin.com/in/seongin-hong-2b95b7345/', x: 375, y: 485, type: 'leaf', parent: 'contact' },
  { id: 'email', label: 'EMAIL', description: 'tjddls207@gmail.com', detail: '프로젝트, 채용, 협업 관련 연락은 이메일로 받을 수 있습니다.', href: 'mailto:tjddls207@gmail.com', x: 560, y: 600, type: 'leaf', parent: 'contact' },
];

const indexById = new Map(nodes.map((node, index) => [node.id, index]));
const links: [number, number][] = nodes.flatMap((node, index) => node.parent ? [[indexById.get(node.parent)!, index]] : []);
---
<Layout homeShell>
  <main id="main" class="portfolio-map">
    <header class="map-header"><a href="/">HONGSEONGIN</a><a class="overview-link" href="/overview/">OVERVIEW ↗</a></header>
    <div class="map-viewport" tabindex="0" aria-label="포트폴리오 그래프. 드래그 또는 휠로 탐색하고, 항목을 선택해 상세 정보를 엽니다.">
      <div class="map-world">
        <svg class="map-lines" viewBox="0 0 1800 1200" aria-hidden="true">
          {links.map(([from, to]) => <line data-from={from} data-to={to} />)}
        </svg>
        {nodes.map((node, index) => <button class:list={['map-node', node.type]} type="button" data-index={index} data-node={node.id} data-parent={node.parent} data-title={node.label} data-description={node.description} data-detail={node.detail} data-highlights={JSON.stringify(node.highlights ?? [])} data-href={node.href} style={`--x:${node.x}px;--y:${node.y}px`} aria-controls="node-detail"><span>{node.label}</span></button>)}
      </div>
      <div class="node-tooltip" role="button" tabindex="0" aria-label="노드 상세 열기"><span class="tooltip-label"></span><p class="tooltip-copy"></p><span class="tooltip-action">CLICK TO EXPAND ↗</span></div>
    </div>
    <div class="map-identity">SEONGINHONG</div>
    <div class="map-action-log" aria-live="polite" aria-atomic="false"></div>
    <div class="map-hud"><span>SCROLL OR DRAG TO EXPLORE</span><span class="map-coordinates">X 0000 Y 0000</span></div>
    <nav class="map-project-index" aria-label="기존 프로젝트 상세 페이지">
      {projects.map((project) => <a href={`/projects/${project.slug}/`}>{project.title}</a>)}
    </nav>
    <aside class="detail-panel" aria-hidden="true">
      <button class="detail-close" type="button" aria-label="상세 패널 닫기">×</button><button class="detail-back" type="button" hidden>← BACK</button>
      <section id="node-detail" tabindex="-1"><p class="detail-kicker"></p><h1 class="detail-title"></h1><strong class="detail-subtitle"></strong><div class="detail-copy"></div><div class="detail-landing" hidden><p>PROJECT HIGHLIGHTS</p><ul></ul></div><nav class="detail-children" aria-label="하위 항목"></nav><a class="detail-link" target="_blank" rel="noreferrer">SOURCE ↗</a></section>
    </aside>
  </main>
</Layout>
<script>
  const viewport=document.querySelector<HTMLElement>('.map-viewport'),world=document.querySelector<HTMLElement>('.map-world'),tooltip=document.querySelector<HTMLElement>('.node-tooltip'),tipLabel=document.querySelector<HTMLElement>('.tooltip-label'),tipCopy=document.querySelector<HTMLElement>('.tooltip-copy'),panel=document.querySelector<HTMLElement>('.detail-panel'),coordinates=document.querySelector<HTMLElement>('.map-coordinates'),actionLog=document.querySelector<HTMLElement>('.map-action-log'),detail=document.querySelector<HTMLElement>('#node-detail'),detailKicker=document.querySelector<HTMLElement>('.detail-kicker'),detailTitle=document.querySelector<HTMLElement>('.detail-title'),detailSubtitle=document.querySelector<HTMLElement>('.detail-subtitle'),detailCopy=document.querySelector<HTMLElement>('.detail-copy'),detailLink=document.querySelector<HTMLAnchorElement>('.detail-link');
  const buttons=[...document.querySelectorAll<HTMLButtonElement>('.map-node')],lines=[...document.querySelectorAll<SVGLineElement>('.map-lines line')];
  if (!detailSubtitle) throw new Error('Missing detail subtitle');
  if(viewport&&world&&tooltip&&tipLabel&&tipCopy&&panel&&coordinates&&actionLog&&detail&&detailKicker&&detailTitle&&detailCopy&&detailLink){let scale=.72,position={x:0,y:0},dragging=false,start={x:0,y:0};const origin=(button:HTMLButtonElement)=>({x:Number.parseFloat(button.style.getPropertyValue('--x')),y:Number.parseFloat(button.style.getPropertyValue('--y'))}),points=buttons.map(origin),apply=()=>world.style.transform=`translate3d(${position.x}px,${position.y}px,0) scale(${scale})`;lines.forEach(line=>{const from=points[Number(line.dataset.from)],to=points[Number(line.dataset.to)];line.setAttribute('x1',`${from.x}`);line.setAttribute('y1',`${from.y}`);line.setAttribute('x2',`${to.x}`);line.setAttribute('y2',`${to.y}`)});const pad=(n:number)=>Math.round(n).toString().padStart(4,'0'),updateCoordinates=(x:number,y:number)=>{const r=viewport.getBoundingClientRect();coordinates.textContent=`X ${pad((x-r.left-position.x)/scale)} Y ${pad((y-r.top-position.y)/scale)}`},center=()=>{const r=viewport.getBoundingClientRect();scale=Math.max(.35,Math.min(.82,r.width/1050));position={x:r.width/2-900*scale,y:r.height/2-600*scale};apply();updateCoordinates(r.left+r.width/2,r.top+r.height/2)};let lastLog='';const note=(message:string)=>{if(message===lastLog)return;lastLog=message;const now=new Date(),stamp=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;const item=document.createElement('p');item.textContent=`> [${stamp}] ${message}`;actionLog.prepend(item);while(actionLog.children.length>3)actionLog.lastElementChild?.remove()};const showTip=(button:HTMLButtonElement,event:PointerEvent)=>{tipLabel.textContent=button.dataset.title||'';tipCopy.textContent=button.dataset.description||'';tooltip.classList.add('visible');const r=viewport.getBoundingClientRect();tooltip.style.left=`${Math.min(r.width-230,Math.max(16,event.clientX-r.left+18))}px`;tooltip.style.top=`${Math.min(r.height-100,Math.max(16,event.clientY-r.top+18))}px`;world.dataset.active=button.dataset.index||'';note(`HOVER ${button.dataset.node?.toUpperCase()}`)};const hideTip=()=>{tooltip.classList.remove('visible');if(!panel.dataset.node)world.dataset.active=''};const open=(button:HTMLButtonElement,push=true)=>{const id=button.dataset.node||'';panel.dataset.node=id;panel.setAttribute('aria-hidden','false');world.dataset.active=button.dataset.index||'';detailKicker.textContent=button.classList.contains('leaf')?'DETAIL / PORTFOLIO NODE':'SECTION / PORTFOLIO MAP';detailTitle.textContent=button.dataset.title||'';detailSubtitle.textContent=button.dataset.description||'';detailCopy.textContent=button.dataset.detail||'';const href=button.dataset.href;if(href){detailLink.href=href;detailLink.hidden=false}else detailLink.hidden=true;note(`OPEN ${id.toUpperCase()}`);if(push)history.pushState({node:id},'',`?node=${id}`);detail.focus()};const close=(push=true)=>{panel.dataset.node='';panel.setAttribute('aria-hidden','true');world.dataset.active='';note('RETURN TO MAP');if(push)history.pushState({},'',location.pathname);viewport.focus()};center();window.addEventListener('resize',center);const initial=new URLSearchParams(location.search).get('node'),initialButton=buttons.find(button=>button.dataset.node===initial);if(initialButton)open(initialButton,false);buttons.forEach(button=>{button.addEventListener('pointerenter',event=>showTip(button,event));button.addEventListener('pointermove',event=>showTip(button,event));button.addEventListener('pointerleave',hideTip);button.addEventListener('click',()=>{note(`CLICK ${button.dataset.node?.toUpperCase()}`);open(button)});button.addEventListener('pointerdown',event=>event.preventDefault())});viewport.addEventListener('pointerdown',event=>{event.preventDefault();if((event.target as HTMLElement).closest('.map-node'))return;dragging=true;start={x:event.clientX,y:event.clientY};viewport.setPointerCapture(event.pointerId);viewport.classList.add('dragging');note('DRAG START')});viewport.addEventListener('pointermove',event=>{updateCoordinates(event.clientX,event.clientY);if(!dragging)return;position.x+=event.clientX-start.x;position.y+=event.clientY-start.y;start={x:event.clientX,y:event.clientY};apply()});const release=(event:PointerEvent)=>{if(dragging)note('DRAG END');dragging=false;viewport.classList.remove('dragging');if(viewport.hasPointerCapture(event.pointerId))viewport.releasePointerCapture(event.pointerId)};viewport.addEventListener('pointerup',release);viewport.addEventListener('pointercancel',release);viewport.addEventListener('wheel',event=>{event.preventDefault();const r=viewport.getBoundingClientRect(),old=scale;scale=Math.max(.35,Math.min(1.05,scale-event.deltaY*.00055));const x=(event.clientX-r.left-position.x)/old,y=(event.clientY-r.top-position.y)/old;position={x:event.clientX-r.left-x*scale,y:event.clientY-r.top-y*scale};apply();updateCoordinates(event.clientX,event.clientY);note('SCROLL INPUT')},{passive:false});document.querySelector<HTMLButtonElement>('.detail-close')?.addEventListener('click',()=>close());viewport.addEventListener('keydown',event=>{if(event.key==='Escape')close();if(event.key==='Home'){center();event.preventDefault()}});window.addEventListener('popstate',()=>{const id=new URLSearchParams(location.search).get('node'),button=buttons.find(candidate=>candidate.dataset.node===id);button?open(button,false):close(false)})}
</script>
<script>
  const hoverNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const hoverLines = [...document.querySelectorAll<SVGLineElement>('.map-lines line')];
  const setConnectedLines = (index?: string) => hoverLines.forEach((line) => line.classList.toggle('is-connected', Boolean(index) && (line.dataset.from === index || line.dataset.to === index)));
  hoverNodes.forEach((node) => {
    node.addEventListener('pointerenter', () => setConnectedLines(node.dataset.index));
    node.addEventListener('pointerleave', () => setConnectedLines());
    node.addEventListener('focus', () => setConnectedLines(node.dataset.index));
    node.addEventListener('blur', () => setConnectedLines());
  });
</script>
<script>
  const hoverCard = document.querySelector<HTMLElement>('.node-tooltip');
  const hoverViewport = document.querySelector<HTMLElement>('.map-viewport');
  const hoverDetailPanel = document.querySelector<HTMLElement>('.detail-panel');
  const hoverWorld = document.querySelector<HTMLElement>('.map-world');
  const hoverDetail = document.querySelector<HTMLElement>('#node-detail');
  const hoverKicker = document.querySelector<HTMLElement>('.detail-kicker');
  const hoverTitle = document.querySelector<HTMLElement>('.detail-title');
  const hoverSubtitle = document.querySelector<HTMLElement>('.detail-subtitle');
  const hoverCopy = document.querySelector<HTMLElement>('.detail-copy');
  const hoverLink = document.querySelector<HTMLAnchorElement>('.detail-link');
  const hoverCardNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  let hoverCardNode: HTMLButtonElement | undefined;
  let hoverLeaveTimer = 0;
  // The viewport owns graph dragging. Stop its pointer-down handler from
  // claiming interactions that begin inside an overlay card, otherwise the
  // card's click is turned into a drag before its detail action can run.
  hoverViewport?.addEventListener('pointerdown', (event: PointerEvent) => {
    if ((event.target as HTMLElement).closest('.node-tooltip, .detail-panel')) event.stopImmediatePropagation();
  }, true);
  const placeHoverCard = (node: HTMLButtonElement) => {
    if (!hoverCard || !hoverViewport) return;
    const nodeRect = node.getBoundingClientRect();
    const viewportRect = hoverViewport.getBoundingClientRect();
    hoverCard.style.left = `${Math.min(viewportRect.width - 230, Math.max(16, nodeRect.left - viewportRect.left + 18))}px`;
    hoverCard.style.top = `${Math.min(viewportRect.height - 110, Math.max(16, nodeRect.bottom - viewportRect.top + 12))}px`;
  };
  hoverCardNodes.forEach((node) => {
    node.addEventListener('pointerenter', () => { hoverCardNode = node; window.clearTimeout(hoverLeaveTimer); });
    node.addEventListener('pointerleave', (event: PointerEvent) => {
      event.stopImmediatePropagation();
      hoverLeaveTimer = window.setTimeout(() => { if (!hoverCard?.matches(':hover')) hoverCard?.classList.remove('visible'); }, 320);
    }, true);
    node.addEventListener('click', (event: MouseEvent) => {
      if (node.dataset.openDetail === 'true') { delete node.dataset.openDetail; return; }
      event.preventDefault();
      event.stopImmediatePropagation();
      hoverCardNode = node;
      placeHoverCard(node);
      hoverCard?.classList.add('visible');
      // Keep the hover card as the preview, but make the graph node itself a
      // reliable expansion target as well. Users should not need to move the
      // pointer from a small node to a floating card before seeing details.
      openHoverDetail(node);
    }, true);
  });
  hoverCard?.addEventListener('pointerenter', () => window.clearTimeout(hoverLeaveTimer));
  hoverCard?.addEventListener('pointerleave', () => hoverCard?.classList.remove('visible'));
  const openHoverDetail = (node: HTMLButtonElement) => {
    if (!hoverDetailPanel || !hoverWorld || !hoverDetail || !hoverKicker || !hoverTitle || !hoverSubtitle || !hoverCopy || !hoverLink) return;
    hoverDetailPanel.dataset.node = node.dataset.node || '';
    hoverDetailPanel.setAttribute('aria-hidden', 'false');
    hoverWorld.dataset.active = node.dataset.index || '';
    hoverKicker.textContent = node.classList.contains('leaf') ? 'DETAIL / PORTFOLIO NODE' : 'SECTION / PORTFOLIO MAP';
    hoverTitle.textContent = node.dataset.title || '';
    hoverSubtitle.textContent = node.dataset.description || '';
    hoverCopy.textContent = node.dataset.detail || '';
    if (node.dataset.href) { hoverLink.href = node.dataset.href; hoverLink.hidden = false; } else hoverLink.hidden = true;
    history.pushState({ node: node.dataset.node }, '', `?node=${node.dataset.node}`);
    hoverDetail.focus();
    hoverCard?.classList.remove('visible');
    window.dispatchEvent(new CustomEvent('portfolio:center-node', { detail: node.dataset.node }));
  };
  const expandHoverCard = () => { if (hoverCardNode) openHoverDetail(hoverCardNode); };
  hoverCard?.addEventListener('click', expandHoverCard);
  hoverCard?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); expandHoverCard(); }
  });
  window.addEventListener('portfolio:open-detail', (event) => {
    const node = hoverCardNodes.find((candidate) => candidate.dataset.node === (event as CustomEvent<string>).detail);
    if (node) openHoverDetail(node);
  });
</script>
<script>
  const childMenu = document.querySelector<HTMLElement>('.detail-children');
  const graphPanel = document.querySelector<HTMLElement>('.detail-panel');
  const graphNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const renderChildren = () => {
    if (!childMenu || !graphPanel) return;
    const active = graphPanel.dataset.node;
    const children = graphNodes.filter((node) => node.dataset.parent === active);
    childMenu.replaceChildren();
    childMenu.hidden = children.length === 0;
    children.forEach((child, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.innerHTML = `<span>${String(index + 1).padStart(2, '0')}</span>${child.dataset.title || ''}<b>↗</b>`;
      button.addEventListener('click', () => window.dispatchEvent(new CustomEvent('portfolio:open-detail', { detail: child.dataset.node })));
      childMenu.append(button);
    });
  };
  if (graphPanel) new MutationObserver(renderChildren).observe(graphPanel, { attributes: true, attributeFilter: ['data-node'] });
  renderChildren();
</script>
<script>
  const panelBack = document.querySelector<HTMLButtonElement>('.detail-back');
  const panelForMode = document.querySelector<HTMLElement>('.detail-panel');
  const allGraphNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const syncDetailMode = () => {
    if (!panelForMode || !panelBack) return;
    const first = panelForMode.getBoundingClientRect();
    const wasLeaf = panelForMode.classList.contains('leaf-detail');
    const current = allGraphNodes.find((node) => node.dataset.node === panelForMode.dataset.node);
    const parent = current?.dataset.parent;
    const isLeaf = current?.classList.contains('leaf') ?? false;
    panelForMode.classList.toggle('leaf-detail', isLeaf);
    panelBack.hidden = !parent;
    panelBack.onclick = () => allGraphNodes.find((node) => node.dataset.node === parent)?.click();
    const last = panelForMode.getBoundingClientRect();
    if (wasLeaf !== isLeaf && panelForMode.getAttribute('aria-hidden') === 'false' && first.width && last.width) {
      const animation = panelForMode.animate([
        { transformOrigin: 'right center', transform: `translateX(${first.left - last.left}px) scaleX(${first.width / last.width})` },
        { transformOrigin: 'right center', transform: 'translateX(0) scaleX(1)' },
      ], { duration: 420, easing: 'cubic-bezier(.16,1,.3,1)' });
      animation.finished.then(() => animation.cancel());
    }
  };
  if (panelForMode) new MutationObserver(syncDetailMode).observe(panelForMode, { attributes: true, attributeFilter: ['data-node'] });
  syncDetailMode();
</script>
<script>
  const focusPanel = document.querySelector<HTMLElement>('.detail-panel');
  const focusNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const focusLines = [...document.querySelectorAll<SVGLineElement>('.map-lines line')];
  const renderBoardFocus = () => {
    const index = focusNodes.find((node) => node.dataset.node === focusPanel?.dataset.node)?.dataset.index;
    focusNodes.forEach((node) => node.classList.toggle('is-board-focus', Boolean(index) && node.dataset.index === index));
    focusLines.forEach((line) => line.classList.toggle('is-board-focus', Boolean(index) && (line.dataset.from === index || line.dataset.to === index)));
  };
  if (focusPanel) new MutationObserver(renderBoardFocus).observe(focusPanel, { attributes: true, attributeFilter: ['data-node'] });
  renderBoardFocus();
</script>
<script>
  const landingPanel = document.querySelector<HTMLElement>('.detail-landing');
  const landingList = landingPanel?.querySelector<HTMLUListElement>('ul');
  const landingGraphPanel = document.querySelector<HTMLElement>('.detail-panel');
  const landingNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const renderLanding = () => {
    if (!landingPanel || !landingList || !landingGraphPanel) return;
    const node = landingNodes.find((candidate) => candidate.dataset.node === landingGraphPanel.dataset.node);
    const highlights = node ? JSON.parse(node.dataset.highlights || '[]') as string[] : [];
    landingList.replaceChildren(...highlights.map((highlight) => {
      const item = document.createElement('li');
      item.textContent = highlight;
      return item;
    }));
    landingPanel.hidden = highlights.length === 0;
  };
  if (landingGraphPanel) new MutationObserver(renderLanding).observe(landingGraphPanel, { attributes: true, attributeFilter: ['data-node'] });
  renderLanding();
</script>
<script>
  const cameraViewport = document.querySelector<HTMLElement>('.map-viewport');
  const cameraWorld = document.querySelector<HTMLElement>('.map-world');
  const cameraNodes = [...document.querySelectorAll<HTMLButtonElement>('.map-node')];
  const transformFor = (x: number, y: number, scale: number) => {
    const rect = cameraViewport!.getBoundingClientRect();
    return `translate3d(${rect.width / 2 - x * scale}px,${rect.height / 2 - y * scale}px,0) scale(${scale})`;
  };
  const playTransform = (from: string, to: string, duration: number) => cameraWorld!.animate(
    [{ transform: from }, { transform: to }],
    { duration, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'forwards' },
  ).finished;
  window.addEventListener('portfolio:focus-node', async (event) => {
    const id = (event as CustomEvent<string>).detail;
    const node = cameraNodes.find((candidate) => candidate.dataset.node === id);
    if (!node || !cameraViewport || !cameraWorld) return;
    const x = Number.parseFloat(node.style.getPropertyValue('--x'));
    const y = Number.parseFloat(node.style.getPropertyValue('--y'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    cameraWorld.getAnimations().forEach((animation) => animation.cancel());
    cameraNodes.forEach((candidate) => candidate.classList.toggle('is-camera-focus', candidate === node));
    const overviewScale = Math.max(.2, Math.min(.56, cameraViewport.clientWidth / 1840, cameraViewport.clientHeight / 1240));
    const overview = transformFor(900, 600, overviewScale);
    const current = getComputedStyle(cameraWorld).transform;
    if (reduced) {
      window.dispatchEvent(new CustomEvent('portfolio:open-detail', { detail: id }));
      cameraWorld.style.transform = transformFor(x, y, 1.35);
      return;
    }
    await playTransform(current, overview, 440);
    cameraWorld.style.transform = overview;
    window.dispatchEvent(new CustomEvent('portfolio:open-detail', { detail: id }));
    await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
    const focused = transformFor(x, y, 1.35);
    await playTransform(overview, focused, 760);
    cameraWorld.style.transform = focused;
  });
</script>
