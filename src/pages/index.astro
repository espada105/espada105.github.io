---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';

type MapNode = {
  id: string;
  label: string;
  description: string;
  detail: string;
  href?: string;
  x: number;
  y: number;
  type: 'core' | 'branch' | 'leaf';
  parent?: string;
  highlights?: string[];
};

const nodes: MapNode[] = [
  { id: 'profile', label: 'PROFILE', description: '홍성인 · AI Software Engineer', detail: 'LLM Agents와 AI Applications를 다루는 AI Software Engineer입니다.', href: profile.github, x: 900, y: 600, type: 'core' },
