---
import { profile } from '../data/profile';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Direction studies — {profile.name}</title>
    <meta name="description" content="홍성인 AI Engineer 포트폴리오의 메인 페이지 레퍼런스 시안" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#studies">시안으로 바로가기</a>
    <header class="index-header">
      <a href="/" class="back-link">← Portfolio</a>
      <p>MAIN PAGE DIRECTION STUDIES</p>
      <span>2026</span>
    </header>
    <main id="studies">
      <section class="intro" aria-labelledby="reference-title">
        <p class="kicker">A starting point, not a template.</p>
        <h1 id="reference-title">Three ways to<br /><em>meet a person.</em></h1>
        <p class="intro-copy">이름, 직업, 한 줄 소개와 사진을 첫 화면의 중심에 둔 포트폴리오 시안입니다. 우주 테마와 장식적 기술 이미지는 제외했습니다.</p>
      </section>

      <section class="study study-paper" aria-labelledby="paper-title">
        <div class="study-meta"><span>01 / THE MONOGRAPH</span><span>WARM · EDITORIAL</span></div>
        <div class="paper-grid">
          <div class="paper-copy">
            <p class="role">{profile.role}</p>
            <h2 id="paper-title">{profile.name}<br /><em>{profile.handle}</em></h2>
            <p class="summary">{profile.intro}<br />{profile.description}</p>
            <a href="#projects" class="text-link">Selected work <span>↘</span></a>
          </div>
          <figure class="portrait portrait-paper">
            <img src="/images/profile-placeholder.svg" alt="프로필 사진 자리 표시자" />
            <figcaption>PORTRAIT / TO BE REPLACED</figcaption>
          </figure>
          <p class="paper-note">A personal portfolio should introduce the person before it explains the practice.</p>
        </div>
      </section>

      <section class="study study-index" aria-labelledby="index-title">
        <div class="study-meta"><span>02 / QUIET INDEX</span><span>DARK · PRECISE</span></div>
        <div class="index-layout">
          <div class="index-identity">
            <p>Independent portfolio</p>
            <h2 id="index-title">{profile.name}<br /><span>AI Engineer</span></h2>
            <p class="index-summary">{profile.description}</p>
          </div>
          <figure class="portrait portrait-index">
            <img src="/images/profile-placeholder.svg" alt="프로필 사진 자리 표시자" />
            <figcaption>PROFILE / 01</figcaption>
          </figure>
          <div class="index-nav" aria-label="시안 내비게이션 예시">
            <a href="#about">About <span>01</span></a>
            <a href="#projects">Projects <span>02</span></a>
            <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
          </div>
        </div>
      </section>

      <section class="study study-gallery" aria-labelledby="gallery-title">
        <div class="study-meta"><span>03 / OPEN STUDIO</span><span>LIGHT · IMAGE-LED</span></div>
        <div class="gallery-layout">
          <figure class="portrait portrait-gallery">
            <img src="/images/profile-placeholder.svg" alt="프로필 사진 자리 표시자" />
            <figcaption>HONGSEONGIN / PROFILE</figcaption>
          </figure>
          <div class="gallery-copy">
            <p class="role">{profile.role}</p>
            <h2 id="gallery-title">Hello,<br />I’m {profile.name}.</h2>
            <p>{profile.intro} {profile.description}</p>
            <div class="availability"><span></span> Currently exploring / building / learning</div>
          </div>
          <aside class="gallery-aside"><span>01</span><span>About me</span><span>Selected work ↓</span></aside>
        </div>
      </section>

      <section class="selection-note">
        <p>PHOTO NOTE</p>
        <p>현재 이미지는 구도 확인용 자리 표시자입니다. 실제 프로필 사진이 제공되면 같은 비율로 바로 교체할 수 있습니다.</p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #ece9e2; scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #232321; font-family: 'DM Sans', 'Noto Sans KR', sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 3px solid #e9502f; outline-offset: 5px; }
  .skip-link { position: fixed; top: -5rem; left: 1rem; z-index: 10; padding: .75rem 1rem; background: #fff; color: #222; }
  .skip-link:focus { top: 1rem; }
  .index-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; min-height: 66px; padding: 0 clamp(20px, 4vw, 60px); border-bottom: 1px solid #bdbbb4; background: #ece9e2; font: 10px/1 'DM Mono', monospace; letter-spacing: .08em; }
  .index-header p { margin: 0; text-align: center; }
  .index-header span { text-align: right; }
  .back-link { min-height: 44px; display: inline-flex; align-items: center; width: fit-content; }
  .intro { padding: clamp(72px, 12vw, 180px) clamp(20px, 9vw, 150px) clamp(96px, 13vw, 190px); background: #ece9e2; }
  .kicker, .role, .study-meta, .selection-note > p:first-child { font: 10px/1.2 'DM Mono', monospace; letter-spacing: .08em; }
  .intro h1 { max-width: 1000px; margin: 20px 0 32px; font-size: clamp(56px, 9.5vw, 148px); font-weight: 500; letter-spacing: -.07em; line-height: .86; }
  .intro h1 em { font-family: 'Newsreader', Georgia, serif; font-weight: 400; }
  .intro-copy { max-width: 430px; margin: 0; color: #65645f; font-size: 15px; line-height: 1.8; word-break: keep-all; }
  .study { min-height: 760px; padding: 20px clamp(20px, 4vw, 60px) 48px; }
  .study-meta { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 18px; border-bottom: 1px solid currentColor; }
  .study-paper { background: #b9412b; color: #f9f6ed; }
  .paper-grid { position: relative; display: grid; grid-template-columns: 1.08fr .72fr; gap: 6vw; min-height: 670px; padding: clamp(40px, 6vw, 88px) clamp(4px, 5vw, 70px) 0; }
  .paper-copy { align-self: center; }
  .role { margin: 0 0 24px; }
  .paper-copy h2 { margin: 0; font-size: clamp(60px, 8.8vw, 136px); font-weight: 500; letter-spacing: -.075em; line-height: .78; }
  .paper-copy h2 em { font-family: 'Newsreader', Georgia, serif; font-size: .49em; font-weight: 400; letter-spacing: -.045em; }
  .summary { margin: 42px 0 0; max-width: 330px; font-size: 15px; line-height: 1.8; word-break: keep-all; }
  .text-link { display: inline-flex; gap: 52px; align-items: center; min-height: 44px; margin-top: 34px; border-bottom: 1px solid; font-size: 13px; }
  .text-link:active { transform: scale(.97); }
  .portrait { margin: 0; overflow: hidden; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .portrait figcaption { font: 9px/1.2 'DM Mono', monospace; letter-spacing: .08em; }
  .portrait-paper { width: min(100%, 440px); aspect-ratio: .78; align-self: end; justify-self: end; background: #d9d0c1; }
  .portrait-paper figcaption { position: relative; margin-top: 12px; }
  .paper-note { position: absolute; right: 4px; bottom: 2px; width: 185px; margin: 0; font: 12px/1.55 'Newsreader', Georgia, serif; }
  .study-index { background: #20211e; color: #e8e5dc; }
  .index-layout { display: grid; grid-template-columns: 1.2fr .65fr .7fr; gap: 4vw; min-height: 670px; padding: clamp(40px, 6vw, 88px) 0 0; }
  .index-identity { align-self: end; padding-bottom: 4px; }
  .index-identity > p:first-child, .index-summary { margin: 0; font-size: 12px; color: #aaa9a1; }
  .index-identity h2 { margin: 22px 0 27px; font-size: clamp(58px, 8vw, 125px); font-weight: 500; letter-spacing: -.075em; line-height: .82; }
  .index-identity h2 span { font-family: 'Newsreader', Georgia, serif; font-size: .52em; font-weight: 400; }
  .index-summary { max-width: 260px; line-height: 1.8; word-break: keep-all; }
  .portrait-index { align-self: start; width: 100%; aspect-ratio: .84; background: #d9d0c1; }
  .portrait-index figcaption { padding-top: 12px; }
  .index-nav { display: flex; flex-direction: column; align-self: end; border-top: 1px solid #63645e; }
  .index-nav a { display: flex; justify-content: space-between; align-items: center; min-height: 58px; border-bottom: 1px solid #63645e; font-size: 13px; transition: padding .18s cubic-bezier(.23,1,.32,1); }
  .index-nav a:hover { padding-left: 8px; }
  .index-nav a:active { transform: scale(.97); }
  .index-nav span { font: 10px 'DM Mono', monospace; }
  .study-gallery { background: #f7f6f1; color: #191919; }
  .gallery-layout { display: grid; grid-template-columns: minmax(240px, .85fr) 1.25fr auto; gap: 5vw; min-height: 670px; padding-top: clamp(40px, 6vw, 88px); }
  .portrait-gallery { align-self: start; max-width: 370px; aspect-ratio: .78; background: #d9d0c1; }
  .portrait-gallery figcaption { margin-top: 12px; }
  .gallery-copy { align-self: center; }
  .gallery-copy h2 { margin: 25px 0 28px; font: 500 clamp(54px, 7.4vw, 116px)/.84 'Newsreader', Georgia, serif; letter-spacing: -.075em; }
  .gallery-copy > p:not(.role) { max-width: 335px; margin: 0; color: #5e5d58; font-size: 15px; line-height: 1.8; word-break: keep-all; }
  .availability { display: flex; gap: 9px; align-items: center; margin-top: 38px; font: 10px 'DM Mono', monospace; letter-spacing: .04em; }
  .availability span { width: 8px; height: 8px; border-radius: 50%; background: #b9412b; }
  .gallery-aside { display: flex; flex-direction: column; justify-content: space-between; min-height: 440px; border-left: 1px solid #bdbbb4; padding-left: 16px; font: 10px/1.2 'DM Mono', monospace; letter-spacing: .05em; white-space: nowrap; }
  .selection-note { display: grid; grid-template-columns: .6fr 1fr; gap: 4vw; padding: 36px clamp(20px, 4vw, 60px) 60px; background: #ece9e2; }
  .selection-note p { margin: 0; max-width: 500px; font-size: 13px; line-height: 1.8; word-break: keep-all; }
  @media (max-width: 780px) {
    .index-header { grid-template-columns: 1fr auto; } .index-header p { display: none; }
    .intro { padding-top: 88px; } .intro h1 { font-size: clamp(52px, 15vw, 104px); }
    .study { min-height: auto; padding-bottom: 36px; } .paper-grid, .index-layout, .gallery-layout { display: flex; flex-direction: column; min-height: 0; gap: 40px; padding: 52px 0 0; }
    .paper-copy, .index-identity, .gallery-copy { order: 0; } .portrait-paper, .portrait-index, .portrait-gallery { width: min(100%, 410px); align-self: flex-start; justify-self: auto; } .paper-note { position: static; width: auto; }
    .paper-copy h2, .index-identity h2 { font-size: clamp(58px, 17vw, 110px); } .gallery-copy h2 { font-size: clamp(54px, 17vw, 105px); }
    .index-nav { width: 100%; } .gallery-aside { width: 100%; min-height: 44px; flex-direction: row; border-top: 1px solid #bdbbb4; border-left: 0; padding: 15px 0 0; }
    .selection-note { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } *, *::before, *::after { transition: none !important; } }
</style>
